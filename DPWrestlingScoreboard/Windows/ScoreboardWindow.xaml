<Window x:Class="DPWrestlingScoreboard.Windows.ScoreboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Табло"
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        Background="#0a0a0a">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#111111" Padding="40,25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Левая часть: Стиль и вес -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock x:Name="styleTextBlock" Text="FS" Foreground="White" FontSize="64" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    <TextBlock x:Name="weightTextBlock" Text="31" Foreground="#888" FontSize="64" FontWeight="Bold" FontFamily="Segoe UI" Margin="30,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                
                <!-- Центр: Период -->
                <Border Grid.Column="1" Background="#1a1a1a" CornerRadius="15" Padding="30,10">
                    <TextBlock x:Name="periodTextBlock" Text="1" Foreground="White" FontSize="48" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                </Border>
                
                <!-- Правая часть: Стадия -->
                <TextBlock Grid.Column="2" x:Name="stageTextBlock" Text="FINAL 1-2" Foreground="#FFD700" FontSize="48" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" MaxWidth="420"/>
            </Grid>
        </Border>

        <!-- Основная часть: Имена, очки, таймер -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Красная сторона -->
            <Border Grid.Column="0" Background="#DC2626">
                <StackPanel VerticalAlignment="Center" Margin="24,16">
                    <!-- Имя борца -->
                    <TextBlock x:Name="redWrestlerTextBlock" Text="WRESTLER 1" Foreground="White" FontSize="48" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16,0,16,20" MaxWidth="520"/>
                    
                    <!-- Статус победителя -->
                    <Border x:Name="redWinnerBorder" Background="#FFD700" CornerRadius="10" Padding="30,10" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="🏆 ПОБЕДИТЕЛЬ" Foreground="#0a0a0a" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </Border>
                    
                    <!-- Счет -->
                    <TextBlock x:Name="redScoreTextBlock" Text="0" Foreground="White" FontSize="220" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="315" ShadowDepth="5" Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- Таймер (центр) -->
            <Border Grid.Column="1" Background="#1a1a1a">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="timerTextBlock" Text="6:00" Foreground="White" FontSize="120" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="315" ShadowDepth="3" Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    
                    <!-- Статус перерыва -->
                    <Border x:Name="breakBorder" Background="#F59E0B" CornerRadius="10" Padding="20,10" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="breakStatusTextBlock" Text="ПЕРЕРЫВ" Foreground="#0a0a0a" FontSize="24" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Синяя сторона -->
            <Border Grid.Column="2" Background="#2563EB">
                <StackPanel VerticalAlignment="Center" Margin="24,16">
                    <!-- Имя борца -->
                    <TextBlock x:Name="blueWrestlerTextBlock" Text="WRESTLER 2" Foreground="White" FontSize="48" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16,0,16,20" MaxWidth="520"/>
                    
                    <!-- Статус победителя -->
                    <Border x:Name="blueWinnerBorder" Background="#FFD700" CornerRadius="10" Padding="30,10" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="🏆 ПОБЕДИТЕЛЬ" Foreground="#0a0a0a" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </Border>
                    
                    <!-- Счет -->
                    <TextBlock x:Name="blueScoreTextBlock" Text="0" Foreground="White" FontSize="220" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="315" ShadowDepth="5" Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
