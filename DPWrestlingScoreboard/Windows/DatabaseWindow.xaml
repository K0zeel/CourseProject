<Window x:Class="DPWrestlingScoreboard.Windows.DatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="База данных борцов"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0a">
    
    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2a2a2a"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🤼" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="База данных борцов" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI"/>
            <TextBlock x:Name="userRoleTextBlock" Foreground="#666" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0" FontFamily="Segoe UI"/>
        </StackPanel>
        
        <!-- Панель управления -->
        <Border Grid.Row="1" Background="#1a1a1a" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <!-- Верхняя панель: кнопки -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="🔄 Сбросить фильтры" Style="{StaticResource DarkButton}" Click="ResetFilters_Click" Margin="0,0,10,5"/>
                    </StackPanel>
                    <WrapPanel x:Name="crudButtonsPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📥 Импорт" Style="{StaticResource DarkButton}" Background="#3B82F6" Click="ImportButton_Click" Margin="0,0,5,5"/>
                        <Button Content="📤 Экспорт" Style="{StaticResource DarkButton}" Background="#8B5CF6" Click="ExportButton_Click" Margin="0,0,5,5"/>
                        <Button x:Name="addButton" Content="➕ Добавить" Style="{StaticResource DarkButton}" Background="#22C55E" Click="AddButton_Click" Margin="0,0,5,5"/>
                        <Button x:Name="editButton" Content="✏️ Редактировать" Style="{StaticResource DarkButton}" Background="#F59E0B" Click="EditButton_Click" Margin="0,0,5,5"/>
                        <Button x:Name="deleteButton" Content="🗑️ Удалить" Style="{StaticResource DarkButton}" Background="#EF4444" Click="DeleteButton_Click" Margin="0,0,0,5"/>
                    </WrapPanel>
                </Grid>
                
                <!-- Фильтры по столбцам -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="ID" Foreground="#888" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    
                    <Border Grid.Column="1" Background="#2a2a2a" CornerRadius="6" Margin="5,0" BorderBrush="#3B82F6" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Foreground="#3B82F6" FontSize="16" 
                                       VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox x:Name="filterNameTextBox"
                                     Background="Transparent" Foreground="White" BorderThickness="0"
                                     Padding="0,10,10,10" FontFamily="Segoe UI" FontSize="14" CaretBrush="White"
                                     TextChanged="Filter_Changed" ToolTip="Введите ФИО для поиска"
                                     VerticalContentAlignment="Center" Width="250"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2" Background="#0a0a0a" CornerRadius="4" Margin="5,0">
                        <TextBox x:Name="filterBirthDateTextBox" Style="{StaticResource DarkTextBox}" 
                                 TextChanged="Filter_Changed" ToolTip="Фильтр по дате (дд.мм.гггг)"/>
                    </Border>
                    
                    <ComboBox x:Name="filterRegionComboBox" Grid.Column="3" Margin="5,0" 
                              SelectionChanged="Filter_Changed" ToolTip="Фильтр по региону"/>
                    
                    <ComboBox x:Name="filterCategoryComboBox" Grid.Column="4" Margin="5,0" 
                              SelectionChanged="Filter_Changed" ToolTip="Фильтр по весу"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Таблица борцов -->
        <Border Grid.Row="2" Background="#1a1a1a" CornerRadius="10" Padding="10">
            <DataGrid x:Name="wrestlersDataGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="#1a1a1a"
                      AlternatingRowBackground="#222"
                      Foreground="White"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#333"
                      SelectionMode="Single"
                      FontFamily="Segoe UI"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2a2a2a"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Resources>
                    <Style x:Key="WrapCellText" TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdWrestler}" Width="50"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Регион" Binding="{Binding Region.RegionName}" Width="150"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Вес (кг)" Binding="{Binding WeightCategory.CategoryName}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
        <!-- Статус бар -->
        <Border Grid.Row="3" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="statusTextBlock" Foreground="#666" FontSize="12" FontFamily="Segoe UI" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="Закрыть" Style="{StaticResource DarkButton}" Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
