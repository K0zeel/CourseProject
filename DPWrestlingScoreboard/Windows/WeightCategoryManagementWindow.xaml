<Window x:Class="DPWrestlingScoreboard.Windows.WeightCategoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Весовые категории"
        Height="480" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#0a0a0a">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1a1a1a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2a2a2a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚖ Управление весовыми категориями"
                   Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" FontFamily="Segoe UI"/>

        <Border Grid.Row="1" Background="#1a1a1a" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Вес (кг)" Foreground="#888" FontSize="10" Margin="0,0,0,5"/>
                    <Border Background="#0a0a0a" CornerRadius="6">
                        <TextBox x:Name="weightTextBox" Background="Transparent" Foreground="White"
                                 BorderThickness="0" Padding="10,8" CaretBrush="White"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Content="➕ Добавить" Style="{StaticResource DarkButton}"
                        Background="#22C55E" VerticalAlignment="Bottom" Click="AddButton_Click" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="✏️ Сохранить" Style="{StaticResource DarkButton}"
                        Background="#F59E0B" VerticalAlignment="Bottom" Click="SaveButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1a1a1a" CornerRadius="10" Padding="10">
            <DataGrid x:Name="categoriesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="#1a1a1a"
                      AlternatingRowBackground="#222"
                      Foreground="White"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#333"
                      SelectionMode="Single"
                      FontFamily="Segoe UI"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionChanged="CategoriesDataGrid_SelectionChanged">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2a2a2a"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdWeightCategory}" Width="60"/>
                    <DataGridTextColumn Header="Вес (кг)" Binding="{Binding CategoryName}" Width="*"/>
                    <DataGridTextColumn Header="Борцов" Binding="{Binding WrestlerCount}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="🗑️ Удалить" Style="{StaticResource DarkButton}" Background="#EF4444"
                    Click="DeleteButton_Click" Margin="0,0,10,0"/>
            <Button Content="Закрыть" Style="{StaticResource DarkButton}" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
